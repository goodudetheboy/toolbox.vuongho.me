rules_version = '2';

// study-assistant (database `toolbox-study-assistant`): each user reads and writes
// only their own notes, and only allowlisted, verified Google accounts get in.
// The allowlist is the two built-in accounts below (keep in sync with ALLOWED_EMAILS in
// .github/workflows/deploy.yml) plus the emails the admin adds on the admin page's Access
// tab, stored in config/access. The API reads the same document.
service cloud.firestore {
  match /databases/{database}/documents {
    function access() {
      return /databases/$(database)/documents/config/access;
    }

    function allowed() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email in ['hochivuong2002@gmail.com', 'tling241004@gmail.com'] ||
          (exists(access()) && request.auth.token.email in get(access()).data.emails));
    }

    // The admin page (/study-assistant/admin) reads everyone's feedback. Keep in sync
    // with ADMIN_EMAIL in src/lib/feedback.ts.
    function admin() {
      return allowed() && request.auth.token.email == 'hochivuong2002@gmail.com';
    }

    // The added emails (admin page, Access tab). Only the admin reads or edits it; the
    // rules above read it through get(), which doesn't need read access.
    match /config/access {
      allow read, write: if admin();
    }

    // Profile (email, name, last seen, app opens) — for the admin page's usage tab.
    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
      allow read: if admin();
    }

    // The note itself plus its subcollections (parts/{part}/attempts/{id}).
    match /users/{uid}/notes/{noteId}/{path=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // Exams (name, date, which notes) for cram sheets.
    match /users/{uid}/exams/{examId} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // Session feedback (👍/👎 + context), kept apart from notes so it outlives them.
    match /users/{uid}/feedback/{attemptId} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // "Send feedback" messages from the account menu: she can send (and see) her own.
    match /users/{uid}/messages/{messageId} {
      allow read, create: if allowed() && request.auth.uid == uid;
    }

    // Collection-group reads for the admin page: every user's feedback, messages, notes and attempts.
    match /{path=**}/messages/{messageId} {
      allow read: if admin();
    }
    match /{path=**}/feedback/{attemptId} {
      allow read: if admin();
    }
    match /{path=**}/notes/{noteId} {
      allow read: if admin();
    }
    match /{path=**}/attempts/{attemptId} {
      allow read: if admin();
    }
  }
}
