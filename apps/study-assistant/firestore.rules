rules_version = '2';

// study-assistant (database `toolbox-study-assistant`): each user reads and writes
// only their own notes, and only allowlisted, verified Google accounts get in.
// Keep this list in sync with ALLOWED_EMAILS in .github/workflows/deploy.yml.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['hochivuong2002@gmail.com', 'tling241004@gmail.com'];
    }

    // The admin page (/study-assistant/admin) reads everyone's feedback. Keep in sync
    // with ADMIN_EMAIL in src/lib/feedback.ts.
    function admin() {
      return allowed() && request.auth.token.email == 'hochivuong2002@gmail.com';
    }

    // Profile (email, name, last seen, app opens) — for the admin page's usage tab.
    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
      allow read: if admin();
    }

    // The note itself plus its subcollections (parts/{part}/attempts/{id}).
    match /users/{uid}/notes/{noteId}/{path=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // Session feedback (👍/👎 + context), kept apart from notes so it outlives them.
    match /users/{uid}/feedback/{attemptId} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // Collection-group reads for the admin page: every user's feedback, notes and attempts.
    match /{path=**}/feedback/{attemptId} {
      allow read: if admin();
    }
    match /{path=**}/notes/{noteId} {
      allow read: if admin();
    }
    match /{path=**}/attempts/{attemptId} {
      allow read: if admin();
    }
  }
}
